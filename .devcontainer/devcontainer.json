{
  "name": "Isolated AI Agent DevContainer",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/guiyomh/features/just:0": {}
  },
  "postCreateCommand": "pip install --upgrade pip ruff pre-commit && just setup || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "skellock.just"
      ]
    }
  },
  "remoteUser": "vscode"
}
